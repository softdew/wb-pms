APP_NAME=CMMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Front end origin, for Sanctum cookie auth
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cmms
DB_USERNAME=postgres
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Redis is OPTIONAL. Leave disabled unless a server is actually available.
# With it disabled, cache/queue/session fall back to the database driver, which
# needs nothing beyond PostgreSQL.
# ---------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_FALLBACK=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Development: write mail to the log. No Mailpit or SMTP server needed.
# Production: switch to smtp and point at whatever relay the client provides.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=cmms@example.test
MAIL_FROM_NAME="${APP_NAME}"

# Development: local disk under storage/app. Production: s3-compatible.
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=debug

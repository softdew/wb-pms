# Same as .env.example, with the optional services switched on where the
# client's infrastructure actually provides them.

APP_ENV=production
APP_DEBUG=false

# Turn on only after confirming a Redis server exists and is reachable.
# If it later becomes unreachable, the app logs a warning and falls back
# to the database drivers rather than failing.
REDIS_ENABLED=true
REDIS_FALLBACK=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
